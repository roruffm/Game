{
  "name": "lichtpfad",
  "private": true,
  "version": "0.1.0",
  "description": "Lichtpfad – ein Pixel-Jump'n'Run, in dem man Gleichnisse Jesu spielt und Bibelverse entdeckt.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/jersey-10": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
